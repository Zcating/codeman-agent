{
  "name": "codeman-agent",
  "version": "0.2.0",
  "description": "Native Windows desktop AI agent with billing tools (DeepSeek, MiniMax)",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "npm run kill-port && vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "serve": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "tauri:dev": "npm run kill-port && tauri dev",
    "kill-port": "node scripts/kill-port.mjs 1420 1421",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:single": "playwright test --workers=1",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix-dangerously",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "license": "MIT",
  "dependencies": {
    "@effect/platform-browser": "^0.75.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@mariozechner/pi-agent": "latest",
    "@mariozechner/pi-ai": "latest",
    "@tanstack/solid-router": "^1.170.15",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-window-state": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.0.0",
    "lucide-solid": "^1.18.0",
    "marked": "^15.0.0",
    "solid-js": "^1.9.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.25.0",
    "@playwright/test": "^1.49.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vite-plus": "^0.1.24",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.5.3"
}
