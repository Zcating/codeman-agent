{
  "name": "codeman-agent",
  "version": "0.2.0",
  "description": "Tray-resident desktop AI agent with billing tools (DeepSeek, MiniMax)",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "npm run kill-port && vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "tauri:dev": "npm run kill-port && tauri dev",
    "kill-port": "node scripts/kill-port.mjs 1420 1421"
  },
  "license": "MIT",
  "dependencies": {
    "@effect/platform-browser": "^0.75.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@mariozechner/pi-agent": "latest",
    "@mariozechner/pi-ai": "latest",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-window-state": "^2",
    "effect": "^3.0.0",
    "marked": "^15.0.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@effect/vitest": "^0.25.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.5.3"
}
