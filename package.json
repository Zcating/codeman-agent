{
  "name": "codeman-agent",
  "version": "0.3.0",
  "description": "Native Windows desktop AI agent with file system tools (DeepSeek, MiniMax)",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare-effect.mjs && npx @electron/rebuild -f",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win nsis --x64",
    "build:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest --run",
    "test:web": "vitest --run --project=web",
    "test:main": "vitest --run --project=main",
    "test:related": "vitest --run related",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:single": "playwright test --workers=1",
    "kill-port": "node scripts/kill-port.mjs 1420 1421",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously && oxfmt --check",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.37.1",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@effect/experimental": "0.60.0",
    "@effect/platform": "^0.75.4",
    "@effect/platform-browser": "^0.75.0",
    "@effect/platform-node": "^0.108.1",
    "@effect/sql": "0.50.0",
    "@effect/sql-sqlite-node": "0.51.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@tanstack/solid-form": "^1.33.2",
    "@tanstack/solid-router": "^1.170.15",
    "@types/shell-quote": "^1.7.5",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.0.0",
    "dotenv": "^17.4.2",
    "effect": "^3.21.4",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "es-toolkit": "^1.47.1",
    "lucide-solid": "^1.18.0",
    "markdown-it": "^14.0.0",
    "markdown-it-task-lists": "^2.0.0",
    "shell-quote": "^1.10.0",
    "solid-js": "^1.9.3",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.9.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@effect/vitest": "^0.25.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "~4.0.6",
    "@playwright/test": "^1.49.0",
    "@sinclair/typebox": "^0.34.49",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron": "^1.6.12",
    "@types/node": "^22.19.21",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "jsdom": "^25.0.0",
    "memfs": "^4.68.0",
    "nock": "^14.0.16",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.5.3"
}
