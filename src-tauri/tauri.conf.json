{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codeman-agent",
  "version": "0.1.0",
  "identifier": "com.zcati.codeman-agent",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": null,
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "codeman-agent",
        "url": "index.html",
        "width": 1280,
        "height": 1280,
        "minWidth": 800,
        "minHeight": 800,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "log": null
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Utility",
    "shortDescription": "LLM chat agent for DeepSeek and MiniMax with file system tools",
    "longDescription": "A single native main window chat agent with file system tools (read/write/edit/search/delete). Settings accessible via in-app route.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
